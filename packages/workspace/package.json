{
  "name": "@chorus/workspace",
  "version": "1.0.0",
  "private": false,
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "description": "Project roots, git status and diffs, worktrees, and path safety.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./diff": {
      "types": "./dist/diff.d.ts",
      "default": "./dist/diff.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "clean": "node ../../scripts/rm.mjs dist *.tsbuildinfo",
    "prepare": "tsc -b tsconfig.build.json"
  },
  "dependencies": {
    "@chorus/ide-protocol": "workspace:*",
    "@chorus/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.1"
  }
}
