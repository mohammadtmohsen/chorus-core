{
  "name": "@mohammadtmohsen/event-store",
  "version": "1.0.1",
  "private": false,
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "description": "Append-only event log plus rebuildable projections over SQLite.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "clean": "node ../../scripts/rm.mjs dist *.tsbuildinfo",
    "prepare": "tsc -b tsconfig.build.json"
  },
  "dependencies": {
    "@mohammadtmohsen/shared": "workspace:*",
    "better-sqlite3": "^13.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.1"
  }
}
